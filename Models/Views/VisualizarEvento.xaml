
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.VisualizarEvento"
    Title="Detalhes do Evento"
    BackgroundColor="#F5F8FF">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- Cabeçalho -->
            <VerticalStackLayout
                Spacing="7"
                Margin="0,5,0,5">

                <Label
                    Text="HAPPY EVENTOS"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="3"
                    TextColor="#4296FF"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Detalhes do Evento"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#152C70"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="Confira todas as informações deste evento."
                    FontSize="14"
                    TextColor="#687895"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Cartão de informações -->
            <Border
                BackgroundColor="White"
                Stroke="#E3ECFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <!-- Nome -->
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="EVENTO"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="#4296FF"/>

                        <Label
                            Text="{Binding Nome}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#152C70"/>
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#E3ECFF"/>

                    <!-- Local -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="LOCAL DO EVENTO"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#9AA8C0"/>

                        <Label
                            Text="{Binding Local}"
                            FontSize="15"
                            TextColor="#26344D"/>
                    </VerticalStackLayout>

                    <!-- Início -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="INÍCIO"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#9AA8C0"/>

                        <Label
                            Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}"
                            FontSize="15"
                            TextColor="#26344D"/>

                        <Label
                            Text="{Binding HorarioInicio, StringFormat='{0:hh\\:mm}'}"
                            FontSize="14"
                            TextColor="#687895"/>
                    </VerticalStackLayout>

                    <!-- Término -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="TÉRMINO"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#9AA8C0"/>

                        <Label
                            Text="{Binding DataTermino, StringFormat='{0:dd/MM/yyyy}'}"
                            FontSize="15"
                            TextColor="#26344D"/>

                        <Label
                            Text="{Binding HorarioTermino, StringFormat='{0:hh\\:mm}'}"
                            FontSize="14"
                            TextColor="#687895"/>
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#E3ECFF"/>

                    <!-- Participantes -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Participantes"
                            FontSize="14"
                            TextColor="#687895"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding NumeroParticipantes}"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#152C70"
                            VerticalOptions="Center"/>
                    </Grid>

                    <!-- Custo individual -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Custo por participante"
                            FontSize="14"
                            TextColor="#687895"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#152C70"
                            VerticalOptions="Center"/>
                    </Grid>

                    <!-- Duração corrigida -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Duração"
                            FontSize="14"
                            TextColor="#687895"
                            VerticalOptions="Center"/>

                        <Label
                            Grid.Column="1"
                            Text="{Binding DuracaoFormatada}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#152C70"
                            VerticalOptions="Center"/>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#E3ECFF"/>

                    <!-- Custo total -->
                    <Border
                        BackgroundColor="#EEF5FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="15">

                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="CUSTO TOTAL DO EVENTO"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#4296FF"/>

                            <Label
                                Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#152C70"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Voltar -->
            <Button
                Text="← Voltar"
                BackgroundColor="#4296FF"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="55"
                Clicked="Voltar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
