
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.MeusEventos"
    Title="Meus Eventos"
    BackgroundColor="#F5F8FF">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="15">

        <!-- Cabeçalho -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="7"
            Margin="0,5,0,0">

            <Label
                Text="HAPPY EVENTOS"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="3"
                TextColor="#4296FF"
                HorizontalOptions="Center"/>

            <Label
                Text="Meus Eventos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#152C70"
                HorizontalOptions="Center"/>

            <Label
                Text="Seus momentos especiais reunidos em um só lugar."
                FontSize="14"
                TextColor="#687895"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Lista de eventos -->
        <CollectionView
            Grid.Row="1"
            x:Name="ListaEventos"
            SelectionMode="Single"
            SelectionChanged="EventoSelecionado">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Padding="20">

                    <Border
                        BackgroundColor="#EEF5FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 30"
                        WidthRequest="95"
                        HeightRequest="95"
                        HorizontalOptions="Center">

                        <Label
                            Text="✦"
                            FontSize="48"
                            TextColor="#4296FF"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>

                    <Label
                        Text="Nenhum evento cadastrado"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#152C70"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Seus eventos aparecerão aqui depois que você cadastrar o primeiro."
                        FontSize="14"
                        TextColor="#687895"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        Stroke="#E3ECFF"
                        StrokeThickness="1"
                        Padding="17"
                        Margin="0,5,0,9"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="{Binding Nome}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#152C70"
                                    VerticalOptions="Center"/>

                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="#EEF5FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="9,5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="EVENTO"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1"
                                        TextColor="#4296FF"/>
                                </Border>
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#E3ECFF"/>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="9">

                                <Label
                                    Text="⌖"
                                    FontSize="19"
                                    TextColor="#4296FF"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Local}"
                                    FontSize="14"
                                    TextColor="#687895"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="9">

                                <Label
                                    Text="▦"
                                    FontSize="17"
                                    TextColor="#4296FF"
                                    VerticalOptions="Center"/>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}"
                                    FontSize="14"
                                    TextColor="#687895"
                                    VerticalOptions="Center"/>
                            </Grid>

                            <Label
                                Text="Toque para visualizar os detalhes →"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#4296FF"
                                HorizontalOptions="End"/>

                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Navegação -->
        <Button
            Grid.Row="2"
            Text="← Página Inicial"
            BackgroundColor="#4296FF"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="55"
            Clicked="Voltar_Clicked"/>

    </Grid>

</ContentPage>
